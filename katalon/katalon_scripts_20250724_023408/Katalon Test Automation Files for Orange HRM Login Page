import static com.kms.katalon.core.checkpoint.CheckpointFactory.findCheckpoint
import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase
import static com.kms.katalon.core.testdata.TestDataFactory.findTestData
import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject
import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject
import com.kms.katalon.core.checkpoint.Checkpoint as Checkpoint
import com.kms.katalon.core.cucumber.keyword.CucumberBuiltinKeywords as CucumberKW
import com.kms.katalon.core.mobile.keyword.MobileBuiltInKeywords as Mobile
import com.kms.katalon.core.model.FailureHandling as FailureHandling
import com.kms.katalon.core.testcase.TestCase as TestCase
import com.kms.katalon.core.testdata.TestData as TestData
import com.kms.katalon.core.testng.keyword.TestNGBuiltinKeywords as TestNGKW
import com.kms.katalon.core.testobject.TestObject as TestObject
import com.kms.katalon.core.webservice.keyword.WSBuiltInKeywords as WS
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import internal.GlobalVariable as GlobalVariable
import org.openqa.selenium.Keys as Keys

/**
 * Test Case: Login to Orange HRM
 * Description: This test case verifies the login functionality of Orange HRM.
 * It checks valid login, validates dashboard navigation, and also validates error messages for invalid login.
 */

// Open the browser and navigate to the Orange HRM login page
WebUI.openBrowser('')
WebUI.maximizeWindow()
WebUI.navigateToUrl('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')

// Wait for page to load completely
WebUI.waitForElementVisible(findTestObject('OrangeHRM/Page_Login/img_Logo'), 10)

// Verify login page elements are displayed
WebUI.verifyElementPresent(findTestObject('OrangeHRM/Page_Login/img_Logo'), 10)
WebUI.verifyElementPresent(findTestObject('OrangeHRM/Page_Login/h5_LoginTitle'), 10)
WebUI.verifyElementText(findTestObject('OrangeHRM/Page_Login/h5_LoginTitle'), 'Login')

// Perform login with valid credentials
WebUI.setText(findTestObject('OrangeHRM/Page_Login/input_Username'), username)
WebUI.setText(findTestObject('OrangeHRM/Page_Login/input_Password'), password)
WebUI.click(findTestObject('OrangeHRM/Page_Login/button_Login'))

// Verify successful login by checking for dashboard elements
WebUI.waitForElementPresent(findTestObject('OrangeHRM/Page_Dashboard/div_Dashboard'), 10)
WebUI.verifyElementText(findTestObject('OrangeHRM/Page_Dashboard/div_Dashboard'), 'Dashboard')

// Verify user profile is displayed in the header
WebUI.verifyElementPresent(findTestObject('OrangeHRM/Page_Dashboard/p_UserDropdown'), 10)

// Logout from the application
WebUI.click(findTestObject('OrangeHRM/Page_Dashboard/p_UserDropdown'))
WebUI.waitForElementVisible(findTestObject('OrangeHRM/Page_Dashboard/a_Logout'), 5)
WebUI.click(findTestObject('OrangeHRM/Page_Dashboard/a_Logout'))

// Verify return to login page
WebUI.waitForElementPresent(findTestObject('OrangeHRM/Page_Login/h5_LoginTitle'), 10)

// Test invalid login scenario
WebUI.setText(findTestObject('OrangeHRM/Page_Login/input_Username'), 'invalid_user')
WebUI.setText(findTestObject('OrangeHRM/Page_Login/input_Password'), 'invalid_password')
WebUI.click(findTestObject('OrangeHRM/Page_Login/button_Login'))

// Verify error message is displayed
WebUI.waitForElementVisible(findTestObject('OrangeHRM/Page_Login/div_InvalidCredentials'), 10)
WebUI.verifyElementText(findTestObject('OrangeHRM/Page_Login/div_InvalidCredentials'), 'Invalid credentials')

// Close browser
WebUI.closeBrowser()
```

