## 5. Script File for Add Employee (TC_AddEmployee_OrangeHRM.groovy)

```groovy
import static com.kms.katalon.core.checkpoint.CheckpointFactory.findCheckpoint
import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase
import static com.kms.katalon.core.testdata.TestDataFactory.findTestData
import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject
import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject
import com.kms.katalon.core.checkpoint.Checkpoint as Checkpoint
import com.kms.katalon.core.cucumber.keyword.CucumberBuiltinKeywords as CucumberKW
import com.kms.katalon.core.mobile.keyword.MobileBuiltInKeywords as Mobile
import com.kms.katalon.core.model.FailureHandling as FailureHandling
import com.kms.katalon.core.testcase.TestCase as TestCase
import com.kms.katalon.core.testdata.TestData as TestData
import com.kms.katalon.core.testng.keyword.TestNGBuiltinKeywords as TestNGKW
import com.kms.katalon.core.testobject.TestObject as TestObject
import com.kms.katalon.core.webservice.keyword.WSBuiltInKeywords as WS
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import internal.GlobalVariable as GlobalVariable
import org.openqa.selenium.Keys as Keys

/**
 * This test case verifies the Add Employee functionality in OrangeHRM Demo site
 */

// Login to OrangeHRM
WebUI.callTestCase(findTestCase('TC_Login_OrangeHRM'), [('username') : username, ('password') : password], FailureHandling.STOP_ON_FAILURE)

// Navigate to PIM module
WebUI.click(findTestObject('OrangeHRM/Page_Dashboard/a_PIM'))
WebUI.waitForPageLoad(10)

// Click Add Employee button
WebUI.waitForElementClickable(findTestObject('OrangeHRM/Page_PIM/button_Add'), 10)
WebUI.click(findTestObject('OrangeHRM/Page_PIM/button_Add'))
WebUI.waitForPageLoad(10)

// Fill employee details
WebUI.waitForElementVisible(findTestObject('OrangeHRM/Page_PIM_AddEmployee/input_FirstName'), 10)
WebUI.setText(findTestObject('OrangeHRM/Page_PIM_AddEmployee/input_FirstName'), firstName)
WebUI.setText(findTestObject('OrangeHRM/Page_PIM_AddEmployee/input_LastName'), lastName)

// Get the employee ID for verification later
String employeeId = WebUI.getAttribute(findTestObject('OrangeHRM/Page_PIM_AddEmployee/input_EmployeeId'), 'value')
println("Employee ID: " + employeeId)

// Toggle Create Login Details
WebUI.click(findTestObject('OrangeHRM/Page_PIM_AddEmployee/span_CreateLoginDetails'))

// Set login details
WebUI.setText(findTestObject('OrangeHRM/Page_PIM_AddEmployee/input_Username'), firstName.toLowerCase() + "." + lastName.toLowerCase())
WebUI.setText(findTestObject('OrangeHRM/Page_PIM_AddEmployee/input_Password'), 'Password123')
WebUI.setText(findTestObject('OrangeHRM/Page_PIM_AddEmployee/input_ConfirmPassword'), 'Password123')

// Enable account
WebUI.click(findTestObject('OrangeHRM/Page_PIM_AddEmployee/span_EnabledStatus'))

// Save employee
WebUI.click(findTestObject('OrangeHRM/Page_PIM_AddEmployee/button_Save'))

// Wait for employee personal details page to load
WebUI.waitForElementPresent(findTestObject('OrangeHRM/Page_PIM_PersonalDetails/h6_PersonalDetails'), 10)

// Verify employee was successfully added by checking the URL contains 'viewPersonalDetails'
WebUI.verifyMatch(WebUI.getUrl(), '.*viewPersonalDetails.*', true)

// Navigate back to employee list
WebUI.click(findTestObject('OrangeHRM/Page_Common/a_EmployeeList'))
WebUI.waitForPageLoad(10)

// Search for the added employee
WebUI.setText(findTestObject('OrangeHRM/Page_PIM/input_EmployeeId'), employeeId)
WebUI.click(findTestObject('OrangeHRM/Page_PIM/button_Search'))

// Wait for search results
WebUI.delay(2)
WebUI.waitForElementVisible(findTestObject('OrangeHRM/Page_PIM/div_SearchResults'), 10)

// Verify employee is in search results
WebUI.verifyElementText(findTestObject('OrangeHRM/Page_PIM/div_EmployeeFirstName'), firstName)
WebUI.verifyElementText(findTestObject('OrangeHRM/Page_PIM/div_EmployeeLastName'), lastName)

// Logout
WebUI.click(findTestObject('OrangeHRM/Page_Common/div_UserDropdown'))
WebUI.waitForElementClickable(findTestObject('OrangeHRM/Page_Common/a_Logout'), 5)
WebUI.click(findTestObject('OrangeHRM/Page_Common/a_Logout'))

// Close browser
WebUI.closeBrowser()
```

