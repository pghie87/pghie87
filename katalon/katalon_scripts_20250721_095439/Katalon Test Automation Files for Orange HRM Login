/**
 * Test Case: Verify required field validation in login form
 * 
 * Steps:
 * 1. Open browser and navigate to login page
 * 2. Click login button without entering username and password
 * 3. Verify required field error messages
 * 4. Enter only username and click login
 * 5. Verify password required error message
 * 6. Enter only password and click login
 * 7. Verify username required error message
 * 8. Close browser
 */

// Open browser and navigate to login page
WebUI.openBrowser('')
WebUI.maximizeWindow()
WebUI.navigateToUrl('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')

