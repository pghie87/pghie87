// Verify required field error messages
WebUI.waitForElementVisible(findTestObject('Object Repository/Login_Page/span_RequiredUsername'), 10)
WebUI.verifyElementText(findTestObject('Object Repository/Login_Page/span_RequiredUsername'), 'Required')
WebUI.verifyElementText(findTestObject('Object Repository/Login_Page/span_RequiredPassword'), 'Required')

// Enter only username and click login
WebUI.setText(findTestObject('Object Repository/Login_Page/input_Username'), 'Admin')
WebUI.click(findTestObject('Object Repository/Login_Page/button_Login'))

// Verify password required error message
WebUI.verifyElementNotPresent(findTestObject('Object Repository/Login_Page/span_RequiredUsername'), 5)
WebUI.verifyElementPresent(findTestObject('Object Repository/Login_Page/span_RequiredPassword'), 5)

// Clear username field and enter only password
WebUI.clearText(findTestObject('Object Repository/Login_Page/input_Username'))
WebUI.setEncryptedText(findTestObject('Object Repository/Login_Page/input_Password'), 'hUKwJTbofgPU9eVlw/CnDQ==')
WebUI.click(findTestObject('Object Repository/Login_Page/button_Login'))

// Verify username required error message
WebUI.verifyElementPresent(findTestObject('Object Repository/Login_Page/span_RequiredUsername'), 5)
WebUI.verifyElementNotPresent(findTestObject('Object Repository/Login_Page/span_RequiredPassword'), 5)

// Close browser
WebUI.closeBrowser()
