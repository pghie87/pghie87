import com.kms.katalon.core.testobject.TestObject as TestObject
import com.kms.katalon.core.webservice.keyword.WSBuiltInKeywords as WS
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import internal.GlobalVariable as GlobalVariable
import org.openqa.selenium.Keys as Keys

/**
 * Test Case: Successful Login to OrangeHRM
 * 
 * Steps:
 * 1. Navigate to the OrangeHRM login page
 * 2. Enter valid username and password
 * 3. Click on the Login button
 * 4. Verify successful login by checking dashboard elements
 */

// Open browser and navigate to OrangeHRM login page
WebUI.openBrowser('')
WebUI.maximizeWindow()
WebUI.navigateToUrl('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')

// Wait for the page to load
WebUI.waitForElementVisible(findTestObject('Login_Page/img_OrangeHRM_Logo'), 10)

// Enter username
WebUI.setText(findTestObject('Login_Page/input_Username'), username)

// Enter password
WebUI.setEncryptedText(findTestObject('Login_Page/input_Password'), password)

// Click on the Login button
WebUI.click(findTestObject('Login_Page/button_Login'))

// Verify successful login by checking for dashboard element
WebUI.waitForElementVisible(findTestObject('Dashboard_Page/h6_Dashboard'), 10)
WebUI.verifyElementText(findTestObject('Dashboard_Page/h6_Dashboard'), 'Dashboard')

// Verify user profile is displayed
WebUI.verifyElementPresent(findTestObject('Dashboard_Page/span_UserDropdown'), 5)

// Take screenshot of successful login
WebUI.takeScreenshot('successful_login.png')

// Close the browser
WebUI.closeBrowser()
```

