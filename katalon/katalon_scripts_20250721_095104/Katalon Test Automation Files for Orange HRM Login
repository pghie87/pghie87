import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import internal.GlobalVariable as GlobalVariable
import org.openqa.selenium.Keys as Keys

/**
 * Invalid Login Test Case for Orange HRM Demo
 * 
 * This test verifies that error message is displayed when logging in with invalid credentials
 */

// Open the browser and navigate to the login page
WebUI.openBrowser('')
WebUI.navigateToUrl('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')

// Wait for page to load completely
WebUI.waitForElementVisible(findTestObject('Page_OrangeHRM_Login/input_Username'), 10)

// Enter invalid username and password
WebUI.setText(findTestObject('Page_OrangeHRM_Login/input_Username'), invalidUsername)
WebUI.setText(findTestObject('Page_OrangeHRM_Login/input_Password'), invalidPassword)

// Click login button
WebUI.click(findTestObject('Page_OrangeHRM_Login/button_Login'))

// Wait for error message and verify it appears
WebUI.waitForElementVisible(findTestObject('Page_OrangeHRM_Login/div_InvalidCredentials'), 10)
WebUI.verifyElementText(findTestObject('Page_OrangeHRM_Login/div_InvalidCredentials'), 'Invalid credentials')

// Take screenshot of error message
WebUI.takeScreenshot('invalid_login_error.png')

// Close the browser
WebUI.closeBrowser()
